# Production settings. Do not fill this in by hand: run  ./scripts/make-prod-env.sh  on the server.
# It writes a .env with fresh random secrets. NEVER commit .env.

# The name this server answers to. A domain you own, or one that needs no domain:
# for the server 203.0.113.7 use  api.203-0-113-7.sslip.io
API_HOST=

# Your Firebase project's id (Firebase console > Project settings).
FIREBASE_PROJECT_ID=

# Random secrets, made by make-prod-env.sh
JWT_SECRET=
POSTGRES_PASSWORD=
AUTH_DB_PASSWORD=
WORKOUT_DB_PASSWORD=
NUTRITION_DB_PASSWORD=
ACTIVITY_DB_PASSWORD=
SOCIAL_DB_PASSWORD=

# Optional
# Browser origins allowed to call the API. Leave unset: the phone app needs none, and in
# production an empty value means no browser origin at all (not localhost).
# CORS_ORIGINS=https://app.example.com
# AUTH_ATTEMPTS_PER_MINUTE=20
# While changing JWT_SECRET (see DEPLOY.md): the old secret, still accepted for 20 minutes.
# JWT_SECRET_PREVIOUS=
# Only for testing the production stack on a laptop (Caddy then listens here instead of 80/443):
# HTTP_PORT=8088
# HTTPS_PORT=8443
