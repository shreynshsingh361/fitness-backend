# Copy this file to .env to change any of these. Everything has a safe
# development default, so the backend runs without a .env file.
#
# NEVER commit a real .env. Production secrets belong in a secrets manager.

# Signs and checks login tokens. The auth service and the gateway must share the same value.
# Use a long random string (at least 16 characters), for example:  openssl rand -hex 32
JWT_SECRET=dev-only-secret-change-me-before-deploying

# Postgres superuser (the per-service logins are created in infra/postgres/init.sql)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_password

# Browser origins allowed to call the API, comma separated (no trailing slash).
# Add the address your frontend is served from. :3100 is the Flutter app running in Chrome.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3100

# "production" on a real server: the gateway and auth service then refuse to start
# with the development JWT_SECRET above or any secret shorter than 32 characters.
APP_ENV=development

# Your Firebase project's id (Firebase console > Project settings). Turns on
# POST /api/v1/auth/firebase. Leave empty to keep Firebase sign-in off.
FIREBASE_PROJECT_ID=hxvy-32756

# Sign-in, sign-up and account deletion allowed per IP address per minute.
AUTH_ATTEMPTS_PER_MINUTE=20

# If a load balancer sits in front of the gateway, its IPs or CIDRs, so the
# per-IP limit sees the real client. Leave empty when nothing is in front.
TRUSTED_PROXIES=

# The old sign-up and login, where nobody checks the email. Off (the default) answers
# 410 so only Firebase sign-in works. "true" is for local development and the smoke tests;
# the server refuses to start with it on when APP_ENV=production.
LEGACY_PASSWORD_AUTH=false
